# AICF Backend Environment Configuration Template
PROJECT_NAME="AICF — AI Content Forensics & Authenticity Intelligence Platform"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/aicf_db"

# Session & Security
# WARNING: Generate a secure 256-bit random string for production
SECRET_KEY="generate_a_secure_random_key_here_for_production"
SESSION_EXPIRE_MINUTES=1440

# Allowed CORS Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
